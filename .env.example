# Copy to server/.env on the production host and edit.

# --- server ---
PORT=4000
HOST=127.0.0.1                 # bind to loopback; nginx proxies to it
NODE_ENV=production

# --- ingestion ---
POLL_INTERVAL_MS=60000         # how often to check the exchanges
BASELINE_MAX=25                # orders ingested per exchange on first boot
FETCH_GAP_MS=500               # min gap between browser-routed fetches
BSE_DAYS=2                     # how many recent days of BSE filings to scan
BSE_MAX_PAGES=3                # BSE pages per day (50 rows each)
# DISABLE_BSE=true             # uncomment to run NSE only

# --- Telegram alerter (server/alerter.js — standalone program) ---
# Required for alerts. Create a bot with @BotFather, add it to your group as an
# ADMIN, then get the group id (see TELEGRAM.md). Group ids look like -1001234567890.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_POLL_MS=60000        # how often the alerter checks for new orders
# ALERT_SEND_GAP_MS=3500     # spacing between messages (Telegram allows ~20/min/group)
# ALERT_MIN_VALUE_CR=0       # only alert orders >= this value in Cr (0 = all)
# ALERT_MAX_PER_POLL=15      # flood guard: max messages posted per cycle
# ALERT_BACKLOG=false        # true = post the existing backlog on first run
# ALERT_STATE_PATH=          # where the de-dupe state lives (default server/data/alerted.json)

# --- optional: AI fallback (only used when a filing has no structured value) ---
# ANTHROPIC_API_KEY=
